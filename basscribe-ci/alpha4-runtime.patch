+float goertzel_mag(const std::vector<float>& audio, double sec, float freq) {
+    if (audio.empty() || freq<18.f || freq>float(BP_SR)*0.48f) return 0.f;
+    constexpr int N=2048;
+    const int64_t center=int64_t(std::llround(sec*double(BP_SR)));
+    const int64_t start=center-N/2;
+    const float w=2.f*PI*freq/float(BP_SR);
+    const float coeff=2.f*std::cos(w);
+    float s1=0.f,s2=0.f;
+    for (int i=0;i<N;i++) {
+        int64_t j=std::clamp<int64_t>(start+i,0,int64_t(audio.size()-1));
+        const float win=0.5f-0.5f*std::cos(2.f*PI*float(i)/float(N-1));
+        const float s0=audio[size_t(j)]*win+coeff*s1-s2;
+        s2=s1; s1=s0;
+    }
+    float power=s1*s1+s2*s2-coeff*s1*s2;
+    return std::sqrt(std::max(0.f,power))/float(N);
+}
+
+float harmonic_fundamental_score(const std::vector<float>& audio, const NoteEvent& e, int midi) {
+    const float f=440.f*std::pow(2.f,(float(midi)-69.f)/12.f);
+    const double p1=e.time+std::min(0.055,std::max(0.018,e.duration*0.28));
+    const double p2=e.time+std::max(0.025,e.duration*0.62);
+    auto at=[&](double t)->float {
+        const float a1=goertzel_mag(audio,t,f);
+        const float a2=goertzel_mag(audio,t,f*2.f);
+        const float a3=goertzel_mag(audio,t,f*3.f);
+        const float a4=goertzel_mag(audio,t,f*4.f);
+        const float sub=goertzel_mag(audio,t,f*0.5f);
+        auto l=[](float x){ return std::log1p(55.f*x); };
+        return 1.18f*l(a1)+0.56f*l(a2)+0.31f*l(a3)+0.18f*l(a4)-0.88f*l(sub);
+    };
+    return 0.56f*at(p1)+0.44f*at(p2);
+}
