+std::pair<float,float> event_contour(const std::vector<FramePred>& fr, const NoteEvent& e) {
+    std::vector<float> vals; float conf=0.f; int n=0;
+    const double a=e.time-0.035, b=e.time+e.duration+0.035;
+    for (auto& f:fr) if (f.time>=a && f.time<=b && f.contourConf>=0.10f) {
+        vals.push_back(f.contourMidi); conf+=f.contourConf; n++;
+    }
+    if (vals.empty()) return {0.f,0.f};
+    std::sort(vals.begin(),vals.end());
+    return {vals[vals.size()/2],conf/float(std::max(1,n))};
