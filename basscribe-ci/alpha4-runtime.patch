+float bp_event_probability(const std::vector<FramePred>& fr, const NoteEvent& e, int midi) {
+    if (midi<MIDI_MIN || midi>MIDI_MAX) return 0.f;
+    const int k=midi-MIDI_MIN;
+    float sum=0.f,mx=0.f; int n=0;
+    const double a=e.time-0.025, b=e.time+e.duration+0.025;
+    for (auto& f:fr) if (f.time>=a && f.time<=b) {
+        sum+=f.note[k]; mx=std::max(mx,f.note[k]); n++;
+    }
+    return n ? 0.62f*(sum/float(n))+0.38f*mx : 0.f;
+}
