+void refine_fundamentals(std::vector<NoteEvent>& notes, const std::vector<FramePred>& fr, const std::vector<float>& audio) {
+    if (notes.empty()) return;
+    std::vector<std::vector<int>> cand(notes.size());
+    std::vector<std::vector<double>> emit(notes.size());
+    for (size_t i=0;i<notes.size();i++) {
+        auto [cm,cc]=event_contour(fr,notes[i]);
+        std::vector<int> v;
+        auto add=[&](int m){ if (m>=MIDI_MIN && m<=MIDI_MAX && std::find(v.begin(),v.end(),m)==v.end()) v.push_back(m); };
+        const int m=notes[i].midi;
+        add(m); add(m-12); add(m+12); add(m-2); add(m-1); add(m+1); add(m+2);
+        if (cc>0.10f) { int c=int(std::lround(cm)); add(c); add(c-1); add(c+1); add(c-12); }
+        std::sort(v.begin(),v.end()); cand[i]=v;
+        for (int c:v) {
+            const float bp=bp_event_probability(fr,notes[i],c);
+            const float hs=harmonic_fundamental_score(audio,notes[i],c);
+            double score=2.05*std::log(double(bp)+0.025)+1.12*double(hs);
+            if (cc>0.10f) {
+                const float d=std::abs(float(c)-cm);
+                const float cw=std::clamp((cc-0.10f)/0.38f,0.f,1.f);
+                score+=1.05*cw*std::exp(-0.5*double(d*d)/(0.72*0.72));
+                if (std::abs(d-12.f)<1.1f) score-=0.92*cw;
+                else if (d>3.f) score-=0.07*cw*std::min(d-3.f,8.f);
+            }
+            if (c==m) score+=0.10; // don't change pitch without real evidence
+            if (c>62 && bp<0.42f) score-=0.08*(c-62);
+            emit[i].push_back(score);
+        }
+    }
+
+    std::vector<std::vector<double>> dp(notes.size());
+    std::vector<std::vector<int>> back(notes.size());
+    for (size_t i=0;i<notes.size();i++) {
+        dp[i].assign(cand[i].size(),-1e30); back[i].assign(cand[i].size(),-1);
+        for (size_t j=0;j<cand[i].size();j++) {
+            if (i==0) { dp[i][j]=emit[i][j]; continue; }
+            for (size_t k=0;k<cand[i-1].size();k++) {
+                const int d=std::abs(cand[i][j]-cand[i-1][k]);
+                double tr=-0.055*double(d);
+                if (d>7) tr-=0.26+0.035*double(d-7);
+                // Fresh attacks can legitimately jump; weak onsets should not
+                // cause octave hopping just because a harmonic briefly wins.
+                const double attack=std::clamp(double(notes[i].onset),0.0,1.0);
+                tr*=1.0-0.42*attack;
+                const double q=dp[i-1][k]+tr+emit[i][j];
+                if (q>dp[i][j]) { dp[i][j]=q; back[i][j]=int(k); }
+            }
+        }
+    }
+    int j=int(std::max_element(dp.back().begin(),dp.back().end())-dp.back().begin());
+    for (size_t ri=notes.size();ri-->0;) {
+        const int old=notes[ri].midi, neu=cand[ri][size_t(j)];
+        if (neu!=old) {
+            notes[ri].midi=neu;
+            notes[ri].confidence=std::clamp(notes[ri].confidence*0.92f+0.04f,0.f,1.f);
+        }
+        if (ri>0) { j=back[ri][size_t(j)]; if (j<0) j=0; }
+    }
+}
