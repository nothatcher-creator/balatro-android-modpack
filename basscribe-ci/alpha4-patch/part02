+void consolidate_events(std::vector<NoteEvent>& notes) {
+    if (notes.size()<2) return;
+    // Remove tiny weak islands after pitch correction, then merge continuation
+    // fragments that do not have evidence of a new pluck.
+    for (size_t i=1;i+1<notes.size();) {
+        auto& a=notes[i-1]; auto& b=notes[i]; auto& c=notes[i+1];
+        const bool island=b.duration<0.115 && b.onset<0.36f && b.confidence<0.55f &&
+            std::abs(a.midi-c.midi)<=1 && std::abs(b.midi-a.midi)>=2 && std::abs(b.midi-c.midi)>=2;
+        if (island) { a.duration=std::max(a.duration,(c.time+c.duration)-a.time); notes.erase(notes.begin()+ptrdiff_t(i)); continue; }
+        i++;
+    }
+    std::vector<NoteEvent> out; out.reserve(notes.size());
+    for (auto n:notes) {
+        if (!out.empty()) {
+            auto& p=out.back();
+            const double gap=n.time-(p.time+p.duration);
+            if (n.midi==p.midi && gap<=0.075 && n.onset<0.50f) {
+                p.duration=std::max(p.duration,(n.time+n.duration)-p.time);
+                p.confidence=std::max(p.confidence,n.confidence);
+                p.onset=std::max(p.onset,n.onset);
+                continue;
+            }
+            // One-semitone low-onset flutter over <100 ms is normally vibrato
+            // / estimator wobble, not a newly fretted note.
+            if (std::abs(n.midi-p.midi)==1 && n.duration<0.10 && n.onset<0.24f && gap<0.04) {
+                p.duration=std::max(p.duration,(n.time+n.duration)-p.time);
+                p.confidence=std::max(p.confidence,n.confidence*0.95f);
+                continue;
+            }
+        }
+        out.push_back(n);
+    }
+    notes.swap(out);
+}
